<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MARMITADAKIMASU</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/css/burger.css">
  <link rel="stylesheet" href="/css/chatgpt.css">

</head>
<body>
  <div class="container-filter" >
  <header style="background-color: #ffb703">

    <div class="main-header">
      <h1 class="site-title" >MarmITADAKIMASU!</h1>
      <button class="btn btn-primary margin-auto">
        <div id=burger class="burger scale"></div> 
      </button>
    </div>
    <div id="burger-expend" class="is-hidden">
      <ul class="categories-list">
        <% link.forEach(cat => { %>
          <li><a href="/category/<%= cat.id %>">
            <strong><%- cat.name %></strong></a>
            <ul>
              <% cat.recipeLink.forEach(recipe => { %> 
              <li><a href="/recipe/<%= recipe.id %>">
                <p><%- recipe.title %></p></a>
              </li>
              <% }) %>
          </ul>
        </li>
        <% }) %>
      </ul> 
    </div>
    
  </header>
<div class="recipe-page">

  <section class="paper-card">

    <h2 class="recipe-title">Recette de <%= recipe.title %></h2>

    

    <p class="recipe-description"><%= recipe.description %></p>

        <div class="recipe-media">
    <img src="/assets/placeholder-recipe-img.jpg" alt="placeholder recette">

  </section>

  <section class="section">
    <h2 class="site-subtitle">Ingrédients</h2>
    <div class="ingredients">
      <% ingredientsComplete.forEach(ingredient => { %>
        <%- include('./ingredient', { ingredient }) %>
      <% }); %>
    </div>


  </section>



  <section class="section instructions">
    <% instructions.sort().forEach(instruction => { %>
      <div class="instruction paper-card">
        <div class="instruction-step">#<%= instruction.step %></div>
        <p class="instruction-text"><%= instruction.description %></p>
      </div>
    <% }); %>
  </section>

  <section class="section comments">
    <% comments.forEach(comment => { %>
      <%- include('./comment', { comment }) %>
    <% }); %>
  </section>

</div>

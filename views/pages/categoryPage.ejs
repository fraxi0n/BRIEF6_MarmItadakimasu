<%- include("../partials/head", { title: "Page d'accueil" }) %>

<main class="category-page">

  <div class="category-header">
    <h2><%= category.name %></h2>
    <p><%= category.description %></p>
  </div>

  <ul class="recipe-list">
    <% recipesTarget.forEach((recipe) => { %>
    <%- include("../components/recipeLinkComponent" , {recipe} )%>
    <% }); %>
  </ul>
</main>

<%- include("../partials/footer") %>